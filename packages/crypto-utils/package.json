{
  "name": "crypto-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Utilidades criptográficas compartidas: AES-256-GCM, HMAC-SHA256 y SHA-256",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests --ext .ts",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.spec.json" }]
    }
  }
}
