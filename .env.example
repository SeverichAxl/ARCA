# =============================================================================
# Sistema de Gestión Humana ARCA Ltda.
# Copie este archivo como .env y reemplace TODOS los valores placeholder.
# Nunca versionar el archivo .env real.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
TZ=America/Bogota

# ------------------------- Puertos publicados --------------------------------
GATEWAY_PORT=4000
FRONTEND_PORT=3000

# Puertos internos de los microservicios (no se publican al host)
AUTH_PORT=4001
PERSONAL_PORT=4002
VACACIONES_PORT=4003
CONTRATOS_PORT=4004
PLANILLAS_PORT=4005

# ------------------------- PostgreSQL ----------------------------------------
POSTGRES_USER=arca_admin
POSTGRES_PASSWORD=change_me_postgres_admin
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Contraseñas de roles owner (migraciones) y app (runtime)
AUTH_DB_OWNER_PASSWORD=change_me_auth_owner_password
AUTH_DB_APP_PASSWORD=change_me_auth_app_password
PERSONAL_DB_OWNER_PASSWORD=change_me_personal_owner_password
PERSONAL_DB_APP_PASSWORD=change_me_personal_app_password
VACACIONES_DB_OWNER_PASSWORD=change_me_vacaciones_owner_password
VACACIONES_DB_APP_PASSWORD=change_me_vacaciones_app_password
CONTRATOS_DB_OWNER_PASSWORD=change_me_contratos_owner_password
CONTRATOS_DB_APP_PASSWORD=change_me_contratos_app_password
PLANILLAS_DB_OWNER_PASSWORD=change_me_planillas_owner_password
PLANILLAS_DB_APP_PASSWORD=change_me_planillas_app_password

# Dentro de Docker el host es postgres; Prisma local usa localhost en los .env de servicios.
AUTH_DATABASE_URL=postgresql://ms_auth_app:change_me_auth_app_password@postgres:5432/db_auth?schema=public
AUTH_DIRECT_URL=postgresql://ms_auth_owner:change_me_auth_owner_password@postgres:5432/db_auth?schema=public
PERSONAL_DATABASE_URL=postgresql://ms_personal_app:change_me_personal_app_password@postgres:5432/db_personal?schema=public
PERSONAL_DIRECT_URL=postgresql://ms_personal_owner:change_me_personal_owner_password@postgres:5432/db_personal?schema=public
VACACIONES_DATABASE_URL=postgresql://ms_vacaciones_app:change_me_vacaciones_app_password@postgres:5432/db_vacaciones?schema=public
VACACIONES_DIRECT_URL=postgresql://ms_vacaciones_owner:change_me_vacaciones_owner_password@postgres:5432/db_vacaciones?schema=public
CONTRATOS_DATABASE_URL=postgresql://ms_contratos_app:change_me_contratos_app_password@postgres:5432/db_contratos?schema=public
CONTRATOS_DIRECT_URL=postgresql://ms_contratos_owner:change_me_contratos_owner_password@postgres:5432/db_contratos?schema=public
PLANILLAS_DATABASE_URL=postgresql://ms_planillas_app:change_me_planillas_app_password@postgres:5432/db_planillas?schema=public
PLANILLAS_DIRECT_URL=postgresql://ms_planillas_owner:change_me_planillas_owner_password@postgres:5432/db_planillas?schema=public

# Prisma validate/generate uses these defaults in CI; local migrations use each
# service's .env, while Docker Compose overrides DATABASE_URL per service.
DATABASE_URL=postgresql://ms_auth_app:change_me_auth_app_password@postgres:5432/db_auth?schema=public
DIRECT_URL=postgresql://ms_auth_owner:change_me_auth_owner_password@postgres:5432/db_auth?schema=public

# Cree un .env ignorado dentro de cada servicio con DATABASE_URL y DIRECT_URL
# apuntando a localhost:POSTGRES_PORT para Prisma local.

# ------------------------- RabbitMQ ------------------------------------------
RABBITMQ_DEFAULT_USER=arca_rabbit
RABBITMQ_DEFAULT_PASS=change_me_rabbit_password
RABBITMQ_DEFAULT_VHOST=arca
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://arca_rabbit:change_me_rabbit_password@rabbitmq:5672
RABBITMQ_HOST=rabbitmq
RABBITMQ_VHOST=arca
RABBITMQ_RETRY_TTL_MS=10000
RABBITMQ_MS_AUTH_USER=ms_auth
RABBITMQ_MS_AUTH_PASSWORD=change_me_ms_auth_rabbit_password
RABBITMQ_MS_PERSONAL_USER=ms_personal
RABBITMQ_MS_PERSONAL_PASSWORD=change_me_ms_personal_rabbit_password
RABBITMQ_MS_VACACIONES_USER=ms_vacaciones
RABBITMQ_MS_VACACIONES_PASSWORD=change_me_ms_vacaciones_rabbit_password
RABBITMQ_MS_CONTRATOS_USER=ms_contratos
RABBITMQ_MS_CONTRATOS_PASSWORD=change_me_ms_contratos_rabbit_password
RABBITMQ_MS_PLANILLAS_USER=ms_planillas
RABBITMQ_MS_PLANILLAS_PASSWORD=change_me_ms_planillas_rabbit_password

# ------------------------- JWT RS256 -----------------------------------------
# Claves en PEM codificadas en base64 (una sola línea) o PEM con \n escapados.
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_RSA_PRIVATE_KEY
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_RSA_PUBLIC_KEY
JWT_KID=arca-2026-01
JWT_ISSUER=arca-auth
JWT_AUDIENCE=arca-services
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------- Cifrado por servicio ------------------------------
# Llaves AES-256-GCM: 32 bytes codificados en base64. Una por servicio.
ENC_KEY_AUTH=REPLACE_WITH_32_BYTE_BASE64_KEY_FOR_AUTH
ENC_KEY_PERSONAL=REPLACE_WITH_32_BYTE_BASE64_KEY_FOR_PERSONAL
ENC_KEY_VACACIONES=REPLACE_WITH_32_BYTE_BASE64_KEY_FOR_VACACIONES
ENC_KEY_CONTRATOS=REPLACE_WITH_32_BYTE_BASE64_KEY_FOR_CONTRATOS
ENC_KEY_PLANILLAS=REPLACE_WITH_32_BYTE_BASE64_KEY_FOR_PLANILLAS
CI_HMAC_KEY=change_me_ci_hmac_key
INTERNAL_HMAC_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY

# ------------------------- Cloudinary ----------------------------------------
CLOUDINARY_CLOUD_NAME=change_me_cloudinary_cloud_name
CLOUDINARY_API_KEY=change_me_cloudinary_api_key
CLOUDINARY_API_SECRET=change_me_cloudinary_api_secret
CLOUDINARY_FOLDER=arca/documentos

# ------------------------- Seed administrador --------------------------------
SEED_ADMIN_EMAIL=admin@arca.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_seed_admin_password
SEED_ADMIN_NOMBRE=Administrador ARCA
RUN_SEED_AUTH=false
RUN_SEED_PERSONAL=false
RUN_SEED_VACACIONES=false

# ------------------------- Aplicación ----------------------------------------
SWAGGER_ENABLED=false
CORS_ORIGIN=http://localhost:3000
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# URLs internas usadas por el gateway (en Docker apuntan a los nombres de servicio)
AUTH_SERVICE_URL=http://ms-auth:4001
PERSONAL_SERVICE_URL=http://ms-personal:4002
VACACIONES_SERVICE_URL=http://ms-vacaciones:4003
CONTRATOS_SERVICE_URL=http://ms-contratos:4004
PLANILLAS_SERVICE_URL=http://ms-planillas:4005

# URL pública consumida por el frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
