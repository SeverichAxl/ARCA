# "mock" activa la simulación local; "DEFAULT" o "api" conectan al API Gateway (predeterminado).
# Reinicia Next.js al cambiar este valor.
NEXT_PUBLIC_AUTH_MODE=DEFAULT

# URL base del API Gateway; se usan /api/auth/login, /api/auth/refresh y /api/auth/logout.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:4000
