// db_planillas — STUB del Sprint 1: solo infraestructura de eventos.
// El modelo de negocio se define en Sprint 2, tras el spike de boletas (TSK-ARQ-108).
generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoParametroLegal {
  SALARIO_MINIMO_NACIONAL
  APORTE_LABORAL
  APORTE_PATRONAL
}

model ParametroLegal {
  id             String             @id @default(uuid()) @db.Uuid
  tipo           TipoParametroLegal
  valor          Decimal            @db.Decimal(14, 4)
  vigenciaDesde  DateTime           @map("vigencia_desde") @db.Date
  vigenciaHasta  DateTime?          @map("vigencia_hasta") @db.Date
  descripcion    String?
  creadoPor      String             @map("creado_por") @db.Uuid
  actualizadoPor String             @map("actualizado_por") @db.Uuid
  creadoEn       DateTime           @default(now()) @map("creado_en")
  actualizadoEn  DateTime           @updatedAt @map("actualizado_en")

  @@unique([tipo, vigenciaDesde])
  @@index([tipo, vigenciaDesde, vigenciaHasta])
  @@map("parametro_legal")
}

model EscalaBonoAntiguedad {
  id             String   @id @default(uuid()) @db.Uuid
  aniosDesde     Int      @map("anios_desde")
  aniosHasta     Int?     @map("anios_hasta")
  porcentaje     Decimal  @db.Decimal(7, 4)
  vigenciaDesde  DateTime @map("vigencia_desde") @db.Date
  vigenciaHasta  DateTime? @map("vigencia_hasta") @db.Date
  creadoPor      String   @map("creado_por") @db.Uuid
  actualizadoPor String   @map("actualizado_por") @db.Uuid
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")

  @@unique([aniosDesde, vigenciaDesde])
  @@index([vigenciaDesde, vigenciaHasta])
  @@map("escala_bono_antiguedad")
}

model EventoProcesado {
  eventId     String   @id @map("event_id") @db.Uuid
  eventName   String   @map("event_name")
  procesadoEn DateTime @default(now()) @map("procesado_en")

  @@map("evento_procesado")
}

model OutboxEvento {
  id          String    @id @db.Uuid
  eventName   String    @map("event_name")
  payload     Json
  occurredOn  DateTime  @map("occurred_on")
  publicadoEn DateTime? @map("publicado_en")
  intentos    Int       @default(0)

  @@index([publicadoEn, occurredOn])
  @@map("outbox_evento")
}
