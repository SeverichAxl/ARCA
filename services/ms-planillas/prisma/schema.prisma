// db_planillas — Sprint 2.
// Modelo base (TSK-ARQ-202, migraciones 20261106120000..20261107191000): parámetros
// legales con vigencia, planilla mensual, detalle y boletas. Sin FK a otras bases.
// Datos sensibles: no guardar CI en claro.
// Extensión del motor de cálculo (TSK-DEV2-201..204, migración 20261109120000):
// desglose completo por funcionario, novedades del mes, política de retención e
// inmutabilidad de planillas cerradas por trigger. Importes calculados en centavos.
generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoParametroLegal {
  SMN
  APORTE_LABORAL
  APORTE_PATRONAL
  BONO_ANTIGUEDAD
  RC_IVA
  OTRO
}

enum EstadoPlanilla {
  BORRADOR
  EN_PROCESO
  CALCULADA
  CERRADA
  ERROR
}

enum EstadoBoleta {
  EMITIDA
  ANULADA
}

model EventoProcesado {
  eventId     String   @id @map("event_id") @db.Uuid
  eventName   String   @map("event_name")
  procesadoEn DateTime @default(now()) @map("procesado_en")

  @@map("evento_procesado")
}

model OutboxEvento {
  id          String    @id @db.Uuid
  eventName   String    @map("event_name")
  payload     Json
  occurredOn  DateTime  @map("occurred_on")
  publicadoEn DateTime? @map("publicado_en")
  intentos    Int       @default(0)

  @@index([publicadoEn, occurredOn])
  @@map("outbox_evento")
}

// Mantenimiento: TSK-SCRUMDEV-201 (CRUD con auditoría). Lectura: motor de cálculo,
// que exige las claves documentadas en docs/api/planillas.md (sin constantes legales).
model ParametroLegal {
  id            String             @id @default(uuid()) @db.Uuid
  tipo          TipoParametroLegal
  clave         String
  valor         Decimal            @db.Decimal(14, 4)
  unidad        String?
  metadata      Json?
  vigenteDesde  DateTime           @map("vigente_desde") @db.Date
  vigenteHasta  DateTime?          @map("vigente_hasta") @db.Date
  activo        Boolean            @default(true)
  creadoPor     String             @map("creado_por") @db.Uuid
  creadoEn      DateTime           @default(now()) @map("creado_en")
  actualizadoEn DateTime           @updatedAt @map("actualizado_en")

  @@unique([tipo, clave, vigenteDesde])
  @@index([activo, vigenteDesde, vigenteHasta])
  @@map("parametro_legal")
}

model PlanillaMensual {
  id                   String         @id @default(uuid()) @db.Uuid
  periodo              String         @unique
  estado               EstadoPlanilla @default(BORRADOR)
  totalEmpleados       Int            @default(0) @map("total_empleados")
  totalGanado          Decimal        @default(0) @map("total_ganado") @db.Decimal(14, 2)
  totalAportesLab      Decimal        @default(0) @map("total_aportes_lab") @db.Decimal(14, 2)
  totalAportesPat      Decimal        @default(0) @map("total_aportes_pat") @db.Decimal(14, 2)
  totalLiquido         Decimal        @default(0) @map("total_liquido") @db.Decimal(14, 2)
  observacion          String?
  procesadaPor         String?        @map("procesada_por") @db.Uuid
  procesadaEn          DateTime?      @map("procesada_en")
  cerradaPor           String?        @map("cerrada_por") @db.Uuid
  cerradaEn            DateTime?      @map("cerrada_en")
  creadoEn             DateTime       @default(now()) @map("creado_en")
  actualizadoEn        DateTime       @updatedAt @map("actualizado_en")
  version              Int            @default(0)
  parametrosAplicados  Json?          @map("parametros_aplicados")
  totalAns             Decimal        @default(0) @map("total_ans") @db.Decimal(14, 2)
  totalRcIva           Decimal        @default(0) @map("total_rc_iva") @db.Decimal(14, 2)
  totalOtrosDescuentos Decimal        @default(0) @map("total_otros_descuentos") @db.Decimal(14, 2)
  duracionMs           Int?           @map("duracion_ms")
  retencionHasta       DateTime?      @map("retencion_hasta") @db.Date
  errorProceso         Json?          @map("error_proceso")
  detalles             PlanillaDetalle[]
  boletas              BoletaPago[]

  @@index([estado, periodo])
  @@map("planilla_mensual")
}

model PlanillaDetalle {
  id                  String          @id @default(uuid()) @db.Uuid
  planillaId          String          @map("planilla_id") @db.Uuid
  planilla            PlanillaMensual @relation(fields: [planillaId], references: [id], onDelete: Restrict)
  empleadoId          String          @map("empleado_id") @db.Uuid
  ciHashRef           String?         @map("ci_hash_ref")
  haberBasico         Decimal         @map("haber_basico") @db.Decimal(14, 2)
  totalGanado         Decimal         @map("total_ganado") @db.Decimal(14, 2)
  bonoAntiguedad      Decimal         @default(0) @map("bono_antiguedad") @db.Decimal(14, 2)
  aporteLaboral       Decimal         @default(0) @map("aporte_laboral") @db.Decimal(14, 2)
  aportePatronal      Decimal         @default(0) @map("aporte_patronal") @db.Decimal(14, 2)
  ans                 Decimal         @default(0) @db.Decimal(14, 2)
  rcIvaComputable     Decimal         @default(0) @map("rc_iva_computable") @db.Decimal(14, 2)
  rcIvaEditadoPor     String?         @map("rc_iva_editado_por") @db.Uuid
  rcIvaEditadoEn      DateTime?       @map("rc_iva_editado_en")
  rcIvaObservacion    String?         @map("rc_iva_observacion")
  liquidoPagable      Decimal         @map("liquido_pagable") @db.Decimal(14, 2)
  subsidiosInfo       Json?           @map("subsidios_info")
  calculoSnapshot     Json?           @map("calculo_snapshot")
  creadoEn            DateTime        @default(now()) @map("creado_en")
  actualizadoEn       DateTime        @updatedAt @map("actualizado_en")
  nombreCompleto      String?         @map("nombre_completo")
  ciEnmascarado       String?         @map("ci_enmascarado") @db.VarChar(30)
  areaId              String?         @map("area_id") @db.Uuid
  cargoId             String?         @map("cargo_id") @db.Uuid
  fechaIngreso        DateTime?       @map("fecha_ingreso") @db.Date
  diasTrabajados      Int             @default(30) @map("dias_trabajados")
  haberGanado         Decimal         @default(0) @map("haber_ganado") @db.Decimal(14, 2)
  aniosAntiguedad     Int             @default(0) @map("anios_antiguedad")
  porcentajeBono      Decimal         @default(0) @map("porcentaje_bono") @db.Decimal(9, 4)
  otrosIngresos       Decimal         @default(0) @map("otros_ingresos") @db.Decimal(14, 2)
  rcIvaBaseImponible  Decimal         @default(0) @map("rc_iva_base_imponible") @db.Decimal(14, 2)
  rcIvaImpuesto       Decimal         @default(0) @map("rc_iva_impuesto") @db.Decimal(14, 2)
  rcIvaSaldoAnterior  Decimal         @default(0) @map("rc_iva_saldo_anterior") @db.Decimal(14, 2)
  rcIvaSaldoSiguiente Decimal         @default(0) @map("rc_iva_saldo_siguiente") @db.Decimal(14, 2)
  rcIva               Decimal         @default(0) @map("rc_iva") @db.Decimal(14, 2)
  otrosDescuentos     Decimal         @default(0) @map("otros_descuentos") @db.Decimal(14, 2)
  totalDescuentos     Decimal         @default(0) @map("total_descuentos") @db.Decimal(14, 2)
  boleta              BoletaPago?

  @@unique([id, planillaId])
  @@unique([planillaId, empleadoId])
  @@index([empleadoId, creadoEn])
  @@index([planillaId, areaId])
  @@map("planilla_detalle")
}

model BoletaPago {
  id                 String          @id @default(uuid()) @db.Uuid
  planillaId         String          @map("planilla_id") @db.Uuid
  planilla           PlanillaMensual @relation(fields: [planillaId], references: [id], onDelete: Restrict)
  detalleId          String          @unique @map("detalle_id") @db.Uuid
  detalle            PlanillaDetalle @relation(fields: [detalleId, planillaId], references: [id, planillaId], onDelete: Restrict)
  empleadoId         String          @map("empleado_id") @db.Uuid
  periodo            String
  liquidoPagable     Decimal         @map("liquido_pagable") @db.Decimal(14, 2)
  hashSha256         String          @map("hash_sha256")
  hashFormulaVersion Int             @default(1) @map("hash_formula_version")
  estado             EstadoBoleta    @default(EMITIDA)
  documentoPublicId  String?         @map("documento_public_id")
  documentoVersion   String?         @map("documento_version")
  documentoMime      String?         @map("documento_mime")
  firmaGraficaRef    String?         @map("firma_grafica_ref")
  emitidaPor         String          @map("emitida_por") @db.Uuid
  emitidaEn          DateTime        @default(now()) @map("emitida_en")

  @@unique([detalleId, planillaId])
  @@index([empleadoId, periodo])
  @@index([planillaId, emitidaEn])
  @@map("boleta_pago")
}

model NovedadPlanilla {
  id              String   @id @default(uuid()) @db.Uuid
  periodo         String   @db.VarChar(7)
  empleadoId      String   @map("empleado_id") @db.Uuid
  diasTrabajados  Int?     @map("dias_trabajados")
  otrosIngresos   Decimal  @default(0) @map("otros_ingresos") @db.Decimal(14, 2)
  otrosDescuentos Decimal  @default(0) @map("otros_descuentos") @db.Decimal(14, 2)
  rcIvaComputable Decimal  @default(0) @map("rc_iva_computable") @db.Decimal(14, 2)
  subsidios       Json     @default("{}")
  observacion     String?  @db.VarChar(500)
  actualizadoPor  String   @map("actualizado_por") @db.Uuid
  actualizadoEn   DateTime @updatedAt @map("actualizado_en")

  @@unique([periodo, empleadoId])
  @@map("novedad_planilla")
}

model ConfiguracionPlanillas {
  clave         String   @id @db.VarChar(60)
  valor         String   @db.VarChar(200)
  descripcion   String?
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion_planillas")
}
