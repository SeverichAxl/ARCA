// db_planillas — Sprint 2: parámetros legales con vigencia, novedades, planilla
// mensual, detalle por funcionario e historial inmutable (HU-20/21/24, RF-23/24/26).
// Los importes se guardan como DECIMAL(14,2) y se calculan en centavos enteros.
// Inmutabilidad de planillas cerradas: triggers en la migración 20261106120000.
generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EstadoPlanilla {
  BORRADOR
  CERRADA
}

// Parámetros escalares con fecha de vigencia (SMN, % aportes, RC-IVA, ANS...).
// Un cambio NO sobrescribe: inserta una nueva fila con otra vigenteDesde.
// Mantenimiento (CRUD y auditoría): TSK-SCRUMDEV-201. Lectura: motor de cálculo.
model ParametroLegal {
  id           String   @id @default(uuid()) @db.Uuid
  clave        String   @db.VarChar(60)
  valor        Decimal  @db.Decimal(18, 6)
  vigenteDesde DateTime @map("vigente_desde") @db.Date
  descripcion  String?
  creadoPor    String?  @map("creado_por") @db.Uuid
  creadoEn     DateTime @default(now()) @map("creado_en")

  @@unique([clave, vigenteDesde])
  @@map("parametro_legal")
}

// Escala del Bono de Antigüedad. Rige el conjunto de filas con la mayor
// vigenteDesde <= fin del periodo. aniosHasta null = sin límite superior.
model EscalaAntiguedad {
  id           String   @id @default(uuid()) @db.Uuid
  aniosDesde   Int      @map("anios_desde")
  aniosHasta   Int?     @map("anios_hasta")
  porcentaje   Decimal  @db.Decimal(9, 4)
  vigenteDesde DateTime @map("vigente_desde") @db.Date
  creadoPor    String?  @map("creado_por") @db.Uuid
  creadoEn     DateTime @default(now()) @map("creado_en")

  @@unique([vigenteDesde, aniosDesde])
  @@map("escala_antiguedad")
}

// Variables del mes por funcionario, cargadas antes del cálculo. Editable solo
// mientras la planilla del periodo no esté CERRADA (servicio + trigger).
model NovedadPlanilla {
  id              String   @id @default(uuid()) @db.Uuid
  periodo         String   @db.VarChar(7) // YYYY-MM
  empleadoId      String   @map("empleado_id") @db.Uuid
  diasTrabajados  Int?     @map("dias_trabajados") // null = calcular por fecha de ingreso
  otrosIngresos   Decimal  @default(0) @map("otros_ingresos") @db.Decimal(14, 2)
  otrosDescuentos Decimal  @default(0) @map("otros_descuentos") @db.Decimal(14, 2)
  rcIvaComputable Decimal  @default(0) @map("rc_iva_computable") @db.Decimal(14, 2) // facturas F-110
  subsidios       Json     @default("{}") // informativos: prenatal, natalidad, lactancia, sepelio
  observacion     String?  @db.VarChar(500)
  actualizadoPor  String   @map("actualizado_por") @db.Uuid
  actualizadoEn   DateTime @updatedAt @map("actualizado_en")

  @@unique([periodo, empleadoId])
  @@map("novedad_planilla")
}

model Planilla {
  id                     String         @id @default(uuid()) @db.Uuid
  periodo                String         @unique @db.VarChar(7) // YYYY-MM; impide duplicados
  anio                   Int
  mes                    Int
  estado                 EstadoPlanilla @default(BORRADOR)
  version                Int            @default(1) // nº de recálculos en BORRADOR
  parametros             Json // snapshot de parámetros aplicados (reproducibilidad)
  totalEmpleados         Int            @map("total_empleados")
  totalGanado            Decimal        @map("total_ganado") @db.Decimal(16, 2)
  totalAportesLaborales  Decimal        @map("total_aportes_laborales") @db.Decimal(16, 2)
  totalAns               Decimal        @map("total_ans") @db.Decimal(16, 2)
  totalRcIva             Decimal        @map("total_rc_iva") @db.Decimal(16, 2)
  totalOtrosDescuentos   Decimal        @map("total_otros_descuentos") @db.Decimal(16, 2)
  totalLiquido           Decimal        @map("total_liquido") @db.Decimal(16, 2)
  totalAportesPatronales Decimal        @map("total_aportes_patronales") @db.Decimal(16, 2)
  duracionMs             Int            @map("duracion_ms")
  calculadoPor           String         @map("calculado_por") @db.Uuid
  calculadoEn            DateTime       @map("calculado_en")
  cerradoPor             String?        @map("cerrado_por") @db.Uuid
  cerradoEn              DateTime?      @map("cerrado_en")
  retencionHasta         DateTime?      @map("retencion_hasta") @db.Date
  creadoEn               DateTime       @default(now()) @map("creado_en")

  detalles PlanillaDetalle[]

  @@index([anio, mes])
  @@index([estado])
  @@map("planilla")
}

// Fila inmutable una vez cerrada la planilla: fuente de boletas (HU-22),
// autoconsulta (HU-23), dashboard (HU-25) y exportación (HU-26).
model PlanillaDetalle {
  id                  String   @id @default(uuid()) @db.Uuid
  planillaId          String   @map("planilla_id") @db.Uuid
  planilla            Planilla @relation(fields: [planillaId], references: [id], onDelete: Cascade)
  empleadoId          String   @map("empleado_id") @db.Uuid
  nombreCompleto      String   @map("nombre_completo")
  ciEnmascarado       String?  @map("ci_enmascarado") @db.VarChar(30)
  areaId              String   @map("area_id") @db.Uuid
  cargoId             String   @map("cargo_id") @db.Uuid
  fechaIngreso        DateTime @map("fecha_ingreso") @db.Date
  haberBasico         Decimal  @map("haber_basico") @db.Decimal(14, 2)
  diasTrabajados      Int      @map("dias_trabajados")
  haberGanado         Decimal  @map("haber_ganado") @db.Decimal(14, 2)
  aniosAntiguedad     Int      @map("anios_antiguedad")
  porcentajeBono      Decimal  @map("porcentaje_bono") @db.Decimal(9, 4)
  bonoAntiguedad      Decimal  @map("bono_antiguedad") @db.Decimal(14, 2)
  otrosIngresos       Decimal  @map("otros_ingresos") @db.Decimal(14, 2)
  totalGanado         Decimal  @map("total_ganado") @db.Decimal(14, 2)
  aporteLaboral       Decimal  @map("aporte_laboral") @db.Decimal(14, 2)
  ans                 Decimal  @db.Decimal(14, 2)
  rcIvaBaseImponible  Decimal  @map("rc_iva_base_imponible") @db.Decimal(14, 2)
  rcIvaImpuesto       Decimal  @map("rc_iva_impuesto") @db.Decimal(14, 2)
  rcIvaComputable     Decimal  @map("rc_iva_computable") @db.Decimal(14, 2)
  rcIvaSaldoAnterior  Decimal  @map("rc_iva_saldo_anterior") @db.Decimal(14, 2)
  rcIvaSaldoSiguiente Decimal  @map("rc_iva_saldo_siguiente") @db.Decimal(14, 2)
  rcIva               Decimal  @map("rc_iva") @db.Decimal(14, 2)
  otrosDescuentos     Decimal  @map("otros_descuentos") @db.Decimal(14, 2)
  totalDescuentos     Decimal  @map("total_descuentos") @db.Decimal(14, 2)
  liquidoPagable      Decimal  @map("liquido_pagable") @db.Decimal(14, 2)
  aportePatronal      Decimal  @map("aporte_patronal") @db.Decimal(14, 2)
  subsidios           Json     @default("{}")
  creadoEn            DateTime @default(now()) @map("creado_en")

  @@unique([planillaId, empleadoId])
  @@index([empleadoId])
  @@index([planillaId, areaId])
  @@map("planilla_detalle")
}

// RETENCION_ANIOS (mínimo 8, CHECK en BD). Política de retención como regla.
model ConfiguracionPlanillas {
  clave         String   @id @db.VarChar(60)
  valor         String   @db.VarChar(200)
  descripcion   String?
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion_planillas")
}

model EventoProcesado {
  eventId     String   @id @map("event_id") @db.Uuid
  eventName   String   @map("event_name")
  procesadoEn DateTime @default(now()) @map("procesado_en")

  @@map("evento_procesado")
}

model OutboxEvento {
  id          String    @id @db.Uuid
  eventName   String    @map("event_name")
  payload     Json
  occurredOn  DateTime  @map("occurred_on")
  publicadoEn DateTime? @map("publicado_en")
  intentos    Int       @default(0)

  @@index([publicadoEn, occurredOn])
  @@map("outbox_evento")
}
