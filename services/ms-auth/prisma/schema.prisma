// db_auth — Identidad, RBAC granular y auditoría inmutable.
// DATABASE_URL = usuario de runtime (ms_auth_app); DIRECT_URL = usuario migrador (ms_auth_owner).
generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO // bloqueo MANUAL por el administrador. El bloqueo por intentos es temporal: ver bloqueadoHasta
}

enum ResultadoAuditoria {
  EXITO
  FALLIDO
  DENEGADO // 403
}

model Usuario {
  id                  String         @id @default(uuid()) @db.Uuid
  username            String         @unique
  email               String?        @unique
  passwordHash        String         @map("password_hash") // Argon2id
  estado              EstadoUsuario  @default(ACTIVO)
  intentosFallidos    Int            @default(0) @map("intentos_fallidos")
  bloqueadoHasta      DateTime?      @map("bloqueado_hasta") // bloqueo temporal (ej. 15 min)
  debeCambiarPassword Boolean        @default(false) @map("debe_cambiar_password")
  // Referencia SIN FK a db_personal.empleado. Va en el JWT como `empleadoId`.
  // Null para cuentas que no son funcionarios (ej. admin técnico).
  empleadoId          String?        @unique @map("empleado_id") @db.Uuid
  rolId               String         @map("rol_id") @db.Uuid
  rol                 Rol            @relation(fields: [rolId], references: [id])
  ultimoLoginEn       DateTime?      @map("ultimo_login_en")
  creadoEn            DateTime       @default(now()) @map("creado_en")
  actualizadoEn       DateTime       @updatedAt @map("actualizado_en")
  refreshTokens       RefreshToken[]

  @@index([rolId])
  @@map("usuario")
}

model Rol {
  id          String       @id @default(uuid()) @db.Uuid
  codigo      String       @unique // ADMIN_GENERAL, RRHH_OPERATIVO, ...
  nombre      String
  descripcion String?
  usuarios    Usuario[]
  permisos    RolPermiso[]

  @@map("rol")
}

model Permiso {
  id          String       @id @default(uuid()) @db.Uuid
  codigo      String       @unique // "personal:read_salary"
  modulo      String // auth | personal | vacaciones | contratos | planillas | transversal
  descripcion String
  roles       RolPermiso[]

  @@map("permiso")
}

model RolPermiso {
  rolId     String  @map("rol_id") @db.Uuid
  permisoId String  @map("permiso_id") @db.Uuid
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

// Se guarda el HASH (SHA-256) del token, nunca el token. Rotación con detección de reuso:
// al refrescar se marca el anterior con reemplazadoPor; si llega un token ya reemplazado,
// se revoca toda la familia (familyId).
model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique @map("token_hash")
  familyId       String    @map("family_id") @db.Uuid
  reemplazadoPor String?   @map("reemplazado_por") @db.Uuid
  expiraEn       DateTime  @map("expira_en")
  revocadoEn     DateTime? @map("revocado_en")
  ipOrigen       String?   @map("ip_origen")
  userAgent      String?   @map("user_agent")
  creadoEn       DateTime  @default(now()) @map("creado_en")

  @@index([usuarioId])
  @@index([familyId])
  @@map("refresh_token")
}

// SOLO INSERT (ver migrations-extra/auditoria_hardening.sql: REVOKE + triggers).
// payload debe llegar con campos sensibles (CI, sueldos) ya enmascarados.
model AuditoriaLog {
  id         BigInt             @id @default(autoincrement())
  eventId    String             @unique @map("event_id") @db.Uuid // idempotencia del consumidor
  usuarioId  String?            @map("usuario_id") @db.Uuid // null en login fallido de usuario inexistente
  ipOrigen   String?            @map("ip_origen")
  modulo     String
  accion     String // LOGIN, LOGIN_FALLIDO, EMPLEADO_CREAR, VACACION_APROBAR, ...
  metodo     String? // POST/PUT/PATCH/DELETE
  recurso    String? // ruta o id del recurso
  resultado  ResultadoAuditoria @default(EXITO)
  payload    Json?              @map("payload_json") // { antes, despues } enmascarado
  ocurridoEn DateTime           @map("ocurrido_en")
  creadoEn   DateTime           @default(now()) @map("creado_en")

  @@index([usuarioId, ocurridoEn])
  @@index([modulo, ocurridoEn])
  @@index([ocurridoEn])
  @@map("auditoria_log")
}

// Parámetros editables del sistema (no los de ley: esos viven en db_planillas).
model ConfiguracionSistema {
  clave         String   @id // MAX_FAILED_LOGIN_ATTEMPTS, LOGIN_LOCK_MINUTES, JWT_ACCESS_TTL_MIN, JWT_REFRESH_TTL_H
  valor         String
  descripcion   String?
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion_sistema")
}