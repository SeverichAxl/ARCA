{
  "name": "ms-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Microservicio de autenticación y autorización",
  "main": "dist/main.js",
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate && nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "test": "jest --passWithNoTests --runInBand",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:validate": "dotenv -e ../../.env -- prisma validate",
    "prisma:seed": "dotenv -e ../../.env -- prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "common-dtos": "workspace:*",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.19.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
