# syntax=docker/dockerfile:1
# Imagen compartida para los microservicios backend y el API gateway.

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
ENV PUPPETEER_SKIP_DOWNLOAD=1
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1
RUN corepack enable \
    && corepack prepare pnpm@9.15.9 --activate \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl wget \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM base AS deps
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api-gateway/package.json apps/api-gateway/package.json
COPY apps/web-frontend/package.json apps/web-frontend/package.json
COPY services/ms-auth/package.json services/ms-auth/package.json
COPY services/ms-personal/package.json services/ms-personal/package.json
COPY services/ms-vacaciones/package.json services/ms-vacaciones/package.json
COPY services/ms-contratos/package.json services/ms-contratos/package.json
COPY services/ms-planillas/package.json services/ms-planillas/package.json
COPY packages/audit/package.json packages/audit/package.json
COPY packages/common-dtos/package.json packages/common-dtos/package.json
COPY packages/crypto-utils/package.json packages/crypto-utils/package.json
COPY packages/database-config/package.json packages/database-config/package.json
COPY packages/internal-auth/package.json packages/internal-auth/package.json
COPY packages/messaging/package.json packages/messaging/package.json
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm fetch --frozen-lockfile \
    && pnpm install --frozen-lockfile --offline \
    && touch /tmp/pnpm-dependencies-ready

FROM deps AS build
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
ENV DIRECT_URL=postgresql://build:build@localhost:5432/build
COPY . .
RUN cp .env.example .env \
    && pnpm --filter '!web-frontend' -r build

FROM base AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api-gateway/package.json apps/api-gateway/package.json
COPY apps/web-frontend/package.json apps/web-frontend/package.json
COPY services/ms-auth/package.json services/ms-auth/package.json
COPY services/ms-personal/package.json services/ms-personal/package.json
COPY services/ms-vacaciones/package.json services/ms-vacaciones/package.json
COPY services/ms-contratos/package.json services/ms-contratos/package.json
COPY services/ms-planillas/package.json services/ms-planillas/package.json
COPY packages/audit/package.json packages/audit/package.json
COPY packages/common-dtos/package.json packages/common-dtos/package.json
COPY packages/crypto-utils/package.json packages/crypto-utils/package.json
COPY packages/database-config/package.json packages/database-config/package.json
COPY packages/internal-auth/package.json packages/internal-auth/package.json
COPY packages/messaging/package.json packages/messaging/package.json
COPY --from=deps /tmp/pnpm-dependencies-ready /tmp/pnpm-dependencies-ready
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --prod --frozen-lockfile --offline --filter '!web-frontend' \
    && pnpm add --global prisma@6.19.3 tsx@4.23.15

COPY --from=build --chown=node:node /app/apps/api-gateway/dist ./apps/api-gateway/dist
COPY --from=build --chown=node:node /app/services/ms-auth/dist ./services/ms-auth/dist
COPY --from=build --chown=node:node /app/services/ms-personal/dist ./services/ms-personal/dist
COPY --from=build --chown=node:node /app/services/ms-vacaciones/dist ./services/ms-vacaciones/dist
COPY --from=build --chown=node:node /app/services/ms-contratos/dist ./services/ms-contratos/dist
COPY --from=build --chown=node:node /app/services/ms-planillas/dist ./services/ms-planillas/dist
COPY --from=build --chown=node:node /app/services/ms-auth/prisma ./services/ms-auth/prisma
COPY --from=build --chown=node:node /app/services/ms-personal/prisma ./services/ms-personal/prisma
COPY --from=build --chown=node:node /app/services/ms-vacaciones/prisma ./services/ms-vacaciones/prisma
COPY --from=build --chown=node:node /app/services/ms-contratos/prisma ./services/ms-contratos/prisma
COPY --from=build --chown=node:node /app/services/ms-planillas/prisma ./services/ms-planillas/prisma
COPY --from=build --chown=node:node /app/packages/audit/dist ./packages/audit/dist
COPY --from=build --chown=node:node /app/packages/common-dtos/dist ./packages/common-dtos/dist
COPY --from=build --chown=node:node /app/packages/crypto-utils/dist ./packages/crypto-utils/dist
COPY --from=build --chown=node:node /app/packages/internal-auth/dist ./packages/internal-auth/dist
COPY --from=build --chown=node:node /app/packages/messaging/dist ./packages/messaging/dist
COPY --from=build --chown=node:node /app/docker/entrypoint.service.sh /usr/local/bin/entrypoint-service
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint-service
USER node
ENTRYPOINT ["sh", "/usr/local/bin/entrypoint-service"]
CMD ["node", "apps/api-gateway/dist/main.js"]
