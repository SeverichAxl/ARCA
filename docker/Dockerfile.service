# syntax=docker/dockerfile:1
# Dockerfile genérico para microservicios NestJS del monorepo.
# Uso: docker build -f docker/Dockerfile.service --build-arg SERVICE=ms-auth .

FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
RUN apk add --no-cache openssl
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY services ./services
COPY apps ./apps
COPY .env.example ./.env.example
# Prisma necesita las variables declaradas en el schema durante generate/validate.
RUN cp .env.example .env
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG SERVICE
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
ENV DIRECT_URL=postgresql://build:build@localhost:5432/build
RUN pnpm --filter "${SERVICE}" build

FROM base AS runtime
ARG SERVICE
ENV NODE_ENV=production
ENV SERVICE=${SERVICE}
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/services ./services
COPY --from=build /app/apps ./apps
COPY --from=build /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml ./
CMD ["sh", "-c", "pnpm --filter ${SERVICE} start:prod"]
