{
  "name": "arco-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de Gestión Humana ARCA Ltda. - monorepo de microservicios NestJS y frontend Next.js",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --workspace-concurrency=1 build",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "corepack pnpm -r --parallel dev",
    "dev:all": "corepack pnpm -r --parallel --filter api-gateway --filter ms-auth --filter ms-personal --filter ms-vacaciones --filter ms-contratos --filter ms-planillas dev",
    "infra:up": "docker compose up -d postgres rabbitmq rabbitmq-init",
    "apps:build": "docker compose --progress=plain build ms-auth && docker compose --progress=plain build web-frontend",
    "apps:up": "docker compose --profile apps up -d",
    "apps:up:demo": "docker compose --profile apps up -d --no-build",
    "apps:down": "docker compose --profile apps down",
    "prisma:validate": "corepack pnpm -r --filter \"./services/*\" prisma:validate",
    "prisma:generate": "corepack pnpm -r --filter \"./services/*\" prisma:generate",
    "db:migrate:all": "dotenv -e .env -- tsx scripts/db-all.ts migrate",
    "db:seed:all": "dotenv -e .env -- tsx scripts/db-all.ts seed",
    "db:reset": "dotenv -e .env -- tsx scripts/db-reset.ts",
    "db:docs": "tsx scripts/gen-db-docs.ts",
    "db:verify-isolation": "dotenv -e .env -- tsx scripts/verificar-aislamiento.ts",
    "db:verify-vacaciones": "dotenv -e .env -- tsx scripts/verificar-restricciones-vacaciones.ts",
    "db:verify-personal": "corepack pnpm --filter ms-personal prisma:generate && dotenv -e .env -- tsx scripts/verificar-personal.ts",
    "db:verify-planillas": "corepack pnpm --filter ms-planillas prisma:generate && dotenv -e .env -- tsx scripts/verificar-planillas.ts",
    "bench:arq204": "tsx scripts/bench-arq204.ts",
    "perf:personal": "corepack pnpm --filter ms-personal prisma:generate && dotenv -e .env -- tsx scripts/perf-personal.ts",
    "messaging:integration": "dotenv -e .env -- tsx packages/messaging/scripts/integration.ts",
    "rbac:export": "tsx scripts/export-rbac-matrix.ts",
    "dev:token": "dotenv -e .env -- tsx scripts/dev-token.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.21",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "postcss@<8.5.10": ">=8.5.10",
      "postcss@<=8.5.11": ">=8.5.12",
      "postcss@<=8.5.22": ">=8.5.23",
      "postcss@<=8.5.17": ">=8.5.18",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "js-yaml@>=5.0.0 <=5.4.0": ">=5.4.1",
      "multer@>=2.0.0 <2.5.0": ">=2.5.0",
      "minimatch@<11.0.1": ">=11.0.1",
      "glob@>=9.0.0 <=14.0.1": ">=14.0.2",
      "basic-ftp": "^6.2.1",
      "sanitize-html": "2.17.7",
      "sanitize-html>htmlparser2": "10.1.0",
      "zod": "^4.6.6"
    }
  }
}
